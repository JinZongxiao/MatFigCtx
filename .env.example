# Copy to .env and fill in your keys. Never commit .env.

# OpenAI-compatible API for visual verifier, KG extraction, and judge
# (e.g. DeepSeek, OpenAI, Gemini, DashScope, OpenRouter, or local vLLM)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Optional: separate OpenAI-compatible endpoint when running SIS extraction via API (--model api:<name>)
VLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VLM_API_BASE_URL=https://api.openai.com/v1
